{
  "expo": {
    "name": "X-Center ID",
    "slug": "authnjs-dashboard",
    "version": "0.1.0",
    "scheme": "authnjs-dashboard",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.xarber.authnjs.dashboard"
    },
    "android": {
      "package": "com.xarber.authnjs.dashboard"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-web-browser",
      "expo-secure-store",
      "expo-sharing",
      ["expo-camera", { "cameraPermission": "Allow X-Center ID to scan a device sign-in code.", "recordAudioAndroid": false }],
      "@react-native-community/datetimepicker"
    ],
    "icon": "./public/authnjs-512.png"
  }
}

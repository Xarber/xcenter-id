{
  "expo": {
    "name": "X-Center ID",
    "slug": "authnjs-dashboard",
    "version": "0.17.0",
    "scheme": "authnjs-dashboard",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "buildNumber": "19",
      "bundleIdentifier": "com.xarber.authnjs.dashboard"
    },
    "android": {
      "versionCode": 19,
      "package": "com.xarber.authnjs.dashboard"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-web-browser",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow X-Center ID to take a profile photo or scan a device sign-in code.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a profile photo for your X-Center ID.",
          "cameraPermission": "Allow X-Center ID to take a profile photo or scan a device sign-in code.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "icon": "./public/authnjs-512.png"
  }
}
